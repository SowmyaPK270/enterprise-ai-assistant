@page "/chat"
@attribute [Authorize]
@using EnterpriseAiAssistant.Domain.Chat

@rendermode InteractiveServer

<PageTitle>AI Assistant</PageTitle>

<div class="chat-page">

    <!-- Sidebar -->
    <aside class="chat-sidebar">

        <div class="sidebar-header">
            <div class="brand">
                <span class="brand-icon">✧</span>
                <span>AI ASSISTANT</span>
            </div>
        </div>

        <button class="new-chat-button"
                @onclick="StartNewChat">

            <span>+</span>
            <span>New chat</span>

        </button>

        <div class="chat-history">

            @foreach (var session in ChatSessions)
            {
                <button class="history-item"
                        @onclick="() => SelectSession(session)">

                    <span class="history-title">
                        @session.Title
                    </span>

                    <span class="history-date">
                        @session.CreatedAt.ToString("MMM dd")
                    </span>

                </button>
            }

        </div>

    </aside>


    <!-- Main Chat Area -->
    <main class="chat-main">

        @if (!HasMessages)
        {
            <!-- Welcome Screen -->

            <section class="welcome-section">

                <div class="welcome-icon">
                    ✧
                </div>

                <h1>Ask anything</h1>

                <p>
                    Search your company’s jobs, documents, and data with AI-powered answers.
                </p>

            </section>
        }
        else
        {
            <!-- Messages -->

            <section class="messages-container" @ref="_messagesContainerRef">

                @foreach (var message in CurrentMessages)
                {
                    var (mainText, footerText) = SplitMessageContent(message.Content);

                    <div class="message-row
                        @(message.Role == ChatRole.User
                            ? "user-message"
                            : "assistant-message")">

                        <div class="message-bubble">

                            <div class="message-role">
                                @(message.Role == ChatRole.User
                                    ? "You"
                                    : "AI Assistant")
                            </div>

                            <div class="message-content">
                                @mainText
                            </div>

                            @if (!string.IsNullOrWhiteSpace(footerText))
                            {
                                <div class="message-footer">
                                    @footerText
                                </div>
                            }

                        </div>

                    </div>
                }

                @if (IsLoading)
                {
                    <div class="message-row assistant-message">

                        <div class="message-bubble">

                            <div class="message-role">
                                AI Assistant
                            </div>

                            @if (string.IsNullOrEmpty(StreamingReply))
                            {
                                <div class="loading-indicator">
                                    Thinking...
                                </div>
                            }
                            else
                            {
                                var (streamingMain, streamingFooter) = SplitMessageContent(StreamingReply);

                                <!-- Grows token-by-token as the response streams in -->
                                <div class="message-content">
                                    @streamingMain
                                </div>

                                @if (!string.IsNullOrWhiteSpace(streamingFooter))
                                {
                                    <div class="message-footer">
                                        @streamingFooter
                                    </div>
                                }
                            }

                        </div>

                    </div>
                }

            </section>
        }


        <!-- Chat Input -->

        <div class="chat-input-wrapper">

            <div class="chat-input-container">

                <textarea class="chat-input"
                          @ref="_inputElement"
                          placeholder="Ask anything about jobs..."
                          @bind="UserInput"
                          @bind:event="oninput"
                          @onkeydown="HandleKeyDown"
                          disabled="@IsLoading">
                </textarea>

                <button class="send-button"
                        @onclick="SendMessageAsync"
                        disabled="@(!CanSendMessage)">

                    ↑

                </button>

            </div>

            <div class="input-footer">

                <span>
                    Enterprise AI Assistant
                </span>

                <span>
                    Enter to send · Shift+Enter for new line
                </span>

            </div>

        </div>

    </main>

</div>